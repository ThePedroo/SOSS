cc_library_shared {
    name: "libgatekeeper",
    srcs: ["gatekeeper.c"],
    cflags: [
        "-std=c99",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
    ],
    shared_libs: ["liblog", "libteecl"],
    version_script: "gatekeeper.map",
    vendor: true
}

/* INFO: Link-time stub for currently proprietary libteecl. */
cc_library_shared {
    name: "libteecl",
    srcs: ["stub/teecl_stub.c"],
    version_script: "stub/teecl.map",
    stubs: {
        symbol_versions: ["TEEGRIS_1"],
    },
    vendor: true
}
